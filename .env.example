# Optional: enables live answers in the AI assistant. Without it the assistant
# answers from the local, grounded fallback in src/lib/assistant.ts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: raises the GitHub API limit for the live activity feed (read-only, public repos).
GITHUB_TOKEN=

# Public URL, used for canonical links, sitemap, and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
