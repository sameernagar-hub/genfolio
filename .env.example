# Copy to .env.local (git-ignored) and fill in. Every variable is optional:
# with no AI key the assistant answers from the offline, grounded fallback.

# --- AI providers --------------------------------------------------------
# Get a Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Get a Groq key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Which provider answers first when both keys are set: gemini | groq.
# The other one is used automatically if the first fails.
AI_PROVIDER=gemini

# --- Other ---------------------------------------------------------------
# Optional: raises the GitHub API limit for the "Shipping" feed (read-only, public repos).
GITHUB_TOKEN=

# Public URL, used for canonical links, sitemap, and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
