{
  "name": "Genfolio",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "src/content/graph.ts"] },
    "vscode": { "extensions": ["bradlc.vscode-tailwindcss"] }
  },
  "postCreateCommand": "npm ci",
  "postAttachCommand": { "server": "npm run dev" },
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "Genfolio", "onAutoForward": "openPreview" } }
}
